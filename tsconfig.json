{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
"strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["js/**/*"],
  "exclude": ["node_modules", "dist"]
}
